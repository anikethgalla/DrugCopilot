# ==============================================================================
# Drug Repurposing Copilot - Environment Configuration
# ==============================================================================

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=biomedical_graph_password_2025
NEO4J_DATABASE=neo4j

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# LLM API (OpenAI-compatible or Anthropic / Google Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Optional: Dedicated biomedical API keys (NCBI/PubMed allows higher rate limits with API key)
NCBI_API_KEY=
PUBMED_EMAIL=user@example.com

# Backend & Ingestion Config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Ingestion batch limits
CHEMBL_LIMIT=500
OPENTARGETS_LIMIT=500
CLINICALTRIALS_LIMIT=200
PUBMED_LIMIT=100

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
